generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id        String   @id @default(cuid())
  name      String
  price     Decimal  @db.Decimal(20,6)
  stock     Decimal  @db.Decimal(20,6)
  createdAt DateTime @default(now())
}